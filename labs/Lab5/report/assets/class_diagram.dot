digraph Lab5Classes {
    rankdir=TB;
    graph [fontname="Arial", bgcolor="white", nodesep=0.45, ranksep=0.7];
    node [shape=record, fontname="Arial", fontsize=10, style="rounded"];
    edge [fontname="Arial", fontsize=9];

    Shape [label="{Shape (abstract)|+ Set()\l+ GetCoords()\l+ Show() = 0\l+ Clone() = 0\l+ Name() = 0\l}"];
    Point [label="{PointShape|+ Show()\l+ Clone()\l}"];
    Line [label="{LineShape|+ Show()\l+ Clone()\l}"];
    Rect [label="{RectShape|+ Show()\l+ Clone()\l}"];
    Ellipse [label="{EllipseShape|+ Show()\l+ Clone()\l}"];
    LineOO [label="{LineOOShape|+ Show()\l+ Clone()\l}"];
    Cube [label="{CubeShape|+ Show()\l+ Clone()\l}"];
    Editor [label="{MyEditor (classic Singleton)|- p_instance_: static MyEditor*\l- Shape** shapes_\l- MyTable* table_\l|+ GetInstance()\l+ DestroyInstance()\l+ Start(Shape*)\l+ SaveToFile()\l}"];
    Table [label="{MyTable|- rows_\l- hDlg_\l- hList_\l|+ Toggle()\l+ Add()\l+ Clear()\l+ Close()\l}"];

    Shape -> Point [arrowhead=empty];
    Shape -> Line [arrowhead=empty, label="virtual"];
    Shape -> Rect [arrowhead=empty, label="virtual"];
    Shape -> Ellipse [arrowhead=empty, label="virtual"];
    Line -> LineOO [arrowhead=empty];
    Ellipse -> LineOO [arrowhead=empty];
    Line -> Cube [arrowhead=empty];
    Rect -> Cube [arrowhead=empty];
    Editor -> Shape [style=dashed, arrowhead=open, label="stores Shape*"];
    Editor -> Table [style=dashed, arrowhead=open, label="notifies"];
}
